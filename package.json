{
  "name": "root",
  "version": "1.0.0",
  "repository": "https://github.com/ATJSH/mini-dice-v1",
  "author": "ATJSH <letaem77@gmail.com>",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web",
    "apps/admin-server",
    "apps/admin-dashboard-server",
    "apps/admin-dashboard-web",
    "docs/*",
    "builders/*"
  ],
  "scripts": {
    "clean": "rimraf apps/*/dist builders/*/dist packages/*/dist",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:ts6",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:ts6": "npm run typecheck:ts6 --workspaces --if-present",
    "packages:build": "concurrently --kill-others-on-fail \"npm:packages:build:*\"",
    "packages:build:scenario-routing": "npm run build --workspace=@packages/scenario-routing",
    "packages:build:shared-types": "npm run build --workspace=@packages/shared-types",
    "packages:build:skill-log-codec": "npm run build --workspace=@packages/skill-log-codec",
    "packages:watch": "concurrently --kill-others \"npm:packages:watch:*\"",
    "packages:watch:scenario-routing": "npm run watch --workspace=@packages/scenario-routing",
    "packages:watch:shared-types": "npm run watch --workspace=@packages/shared-types",
    "packages:watch:skill-log-codec": "npm run watch --workspace=@packages/skill-log-codec",
    "server:dev": "npm run dev --workspace=@apps/server",
    "server:build": "npm run build --workspace=@builders/server",
    "server:minify": "npm run minify --workspace=@builders/server",
    "server:build:watch": "npm run watch --workspace=@builders/server",
    "server:typecheck": "npm run typecheck --workspace=@apps/server",
    "server:typecheck:watch": "npm run typecheck:watch --workspace=@apps/server",
    "server:deploy": "npm run deploy --workspace=@apps/server",
    "web:dev": "npm run dev --workspace=@apps/web",
    "web:build": "npm run build --workspace=@apps/web",
    "web:preview": "npm run preview --workspace=@apps/web",
    "admin-server:dev": "npm run start:dev --workspace=@apps/admin-server",
    "admin-server:build": "npm run build --workspace=@apps/admin-server",
    "admin-server:typecheck": "npm run typecheck --workspace=@apps/admin-server",
    "admin-dashboard-server:dev": "npm run dev --workspace=@apps/admin-dashboard-server",
    "admin-dashboard-server:build": "npm run build --workspace=@apps/admin-dashboard-server",
    "admin-dashboard-server:typecheck": "npm run typecheck --workspace=@apps/admin-dashboard-server",
    "admin-dashboard-web:dev": "npm run dev --workspace=@apps/admin-dashboard-web",
    "admin-dashboard-web:build": "npm run build --workspace=@apps/admin-dashboard-web",
    "admin-dashboard-web:preview": "npm run preview --workspace=@apps/admin-dashboard-web"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "overrides": {
    "@typescript/old": "npm:typescript@6.0.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "concurrently": "10.0.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.5",
    "rimraf": "6.1.3",
    "serverless": "3.40.0",
    "serverless-offline": "13.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
