{
  "name": "@apps/admin-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/typeorm-data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/typeorm-data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/typeorm-data-source.ts",
    "migration:skill-log": "ts-node src/migrator/skill-log-migration.cli.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/config/typeorm-data-source.ts",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6": "tsc6 --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/typeorm": "11.0.3",
    "@packages/skill-log-codec": "0.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.3",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@types/source-map-support": "^0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
