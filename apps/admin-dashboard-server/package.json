{
  "name": "@apps/admin-dashboard-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=es2022 --format=esm --banner:js=\"import { createRequire } from 'module';const require=createRequire(import.meta.url);\" --outfile=dist/index.mjs --external:pg-native"
  },
  "dependencies": {
    "@simplewebauthn/server": "^10.0.0",
    "hono": "^4.6.15",
    "postgres": "^3.4.5",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.0.2"
  }
}
