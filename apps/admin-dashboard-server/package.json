{
  "name": "@apps/admin-dashboard-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6": "tsc6 --noEmit -p tsconfig.json",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --banner:js=\"import { createRequire } from 'module';const require=createRequire(import.meta.url);\" --outfile=dist/index.mjs --external:pg-native"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.2",
    "hono": "4.12.31",
    "postgres": "3.4.9",
    "uuid": "^11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "tsx": "4.23.1"
  }
}
