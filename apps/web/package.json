{
  "name": "@apps/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "git -C ../.. submodule update --init --depth 1 apps/web/vendor/passkey-authenticator-aaguids && vite --host 127.0.0.1 --port 1234",
    "build": "git -C ../.. submodule update --init --depth 1 apps/web/vendor/passkey-authenticator-aaguids && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:ts6": "tsc6 --noEmit -p tsconfig.json && tsc6 --noEmit -p tsconfig.node.json",
    "preview": "vite preview --host 127.0.0.1 --port 1234"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.3",
    "@packages/scenario-routing": "0.0.0",
    "@packages/shared-types": "0.0.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "jotai": "^2.20.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "4.3.3",
    "vite": "8.1.5"
  }
}
