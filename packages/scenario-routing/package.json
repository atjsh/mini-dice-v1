{
  "name": "@packages/scenario-routing",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "concurrently --kill-others-on-fail \"npm:build:*\"",
    "build:cjs": "tsc -b -v tsconfig.cjs.json",
    "build:esm": "tsc -b -v tsconfig.esm.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6": "tsc6 --noEmit -p tsconfig.json",
    "watch": "concurrently --kill-others \"npm:watch:*\"",
    "watch:cjs": "tsc -b -v --watch tsconfig.cjs.json",
    "watch:esm": "tsc -b -v --watch tsconfig.esm.json"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/src/index.d.ts",
        "default": "./dist/esm/src/index.js"
      },
      "require": {
        "types": "./dist/cjs/src/index.d.ts",
        "default": "./dist/cjs/src/index.js"
      }
    }
  },
  "types": "src/index.ts",
  "main": "src/index.ts",
  "sideEffects": false
}
